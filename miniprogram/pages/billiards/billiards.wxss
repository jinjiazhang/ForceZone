.container {
  height: 100vh;
  width: 100vw;
  background-color: #1a1a1a;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  position: relative;
}

.table-area {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 带有木质边框的球台框架 */
.table-frame {
  height: 88vh; 
  width: calc(88vh / 1.83); 
  max-width: 85vw;
  border: 18rpx solid #3d230d; /* 边框在这里 */
  border-radius: 12rpx;
  box-shadow: 0 20rpx 80rpx rgba(0,0,0,0.9);
  position: relative;
  overflow: hidden;
  box-sizing: content-box; /* 确保边框向外扩展，内部空间纯净 */
}

/* 纯净的绿色桌面 Canvas */
.pool-canvas {
  width: 100%;
  height: 100%;
  background-color: #076324;
  display: block;
}

/* Side Controls ... (保持原样) */
.side-control {
  position: absolute;
  bottom: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 50;
  width: 110rpx;
}

.left { left: 5rpx; }
.right { right: 5rpx; }

/* Force perfect circle */
.side-circle-btn {
  width: 100rpx !important;
  height: 100rpx !important;
  min-width: 100rpx !important;
  min-height: 100rpx !important;
  border-radius: 50% !important;
  display: flex !important;
  justify-content: center;
  align-items: center;
  padding: 0 !important;
  margin: 0 !important;
  font-weight: 800;
  font-size: 28rpx;
  box-shadow: 0 8rpx 16rpx rgba(0,0,0,0.5);
  border: 3rpx solid rgba(255,255,255,0.2);
  overflow: hidden;
  box-sizing: border-box;
}

.side-circle-btn::after {
  border: none !important;
}

.p1-btn { 
  background: linear-gradient(135deg, #f8f9fa, #ced4da); 
  color: #212529; 
}

.p2-btn { 
  background: linear-gradient(135deg, #ff4d4d, #cc0000); 
  color: #ffffff; 
}

.side-circle-btn:active {
  transform: scale(0.92);
}

/* Vertical Power Bar */
.v-power-bar-container {
  width: 24rpx;
  height: 200rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255,255,255,0.1);
  position: relative;
}

.v-power-bar {
  position: absolute;
  bottom: 0;
  width: 100%;
  background: linear-gradient(to top, #4cd137, #fbc531, #e84118);
  transition: height 0.05s linear;
}

/* Result Overlay */
.overlay {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.85);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.result-box {
  background: #fff;
  padding: 60rpx;
  border-radius: 40rpx;
  text-align: center;
  width: 70%;
  box-shadow: 0 15rpx 30rpx rgba(0,0,0,0.5);
}

.winner-text {
  font-size: 44rpx;
  font-weight: 800;
  color: #d35400;
  margin-bottom: 30rpx;
}

.stats {
  margin-bottom: 40rpx;
  font-size: 32rpx;
  color: #34495e;
}

.reset-btn {
  background: #27ae60;
  color: #fff;
  border-radius: 50rpx;
  font-weight: bold;
}
