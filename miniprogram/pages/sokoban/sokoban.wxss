.container {
  height: 100vh;
  width: 100vw;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #2C1810 0%, #1A0F0A 100%);
  overflow: hidden;
  position: relative;
}

/* === 顶部信息栏 === */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  background: rgba(0,0,0,0.3);
  border-bottom: 2rpx solid rgba(255,255,255,0.08);
}

.level-info {
  display: flex;
  align-items: center;
}

.level-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #F5DEB3;
}

.steps-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,0.1);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

.steps-icon {
  font-size: 28rpx;
}

.steps-count {
  font-size: 30rpx;
  font-weight: 700;
  color: white;
  min-width: 40rpx;
  text-align: center;
}

.top-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}

.action-btn:active {
  background: rgba(255,255,255,0.25);
  transform: scale(0.92);
}

.action-icon {
  font-size: 32rpx;
  color: #F5DEB3;
}

/* === 游戏区域 === */
.game-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
}

.grid-wrapper {
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}

/* === 格子基础 === */
.cell {
  position: absolute;
  box-sizing: border-box;
}

/* 空地 - 墙外 */
.cell.empty {
  background: transparent;
}

/* 墙壁 - 深色砖块 */
.cell.wall {
  background: linear-gradient(145deg, #5D4037, #3E2723);
  border: 1rpx solid #2C1810;
  box-shadow: inset 0 2rpx 4rpx rgba(255,255,255,0.08), inset 0 -2rpx 4rpx rgba(0,0,0,0.4);
}

/* 地板 */
.cell.floor {
  background: linear-gradient(145deg, #C8B99A, #B8A88A);
  border: 1rpx solid rgba(0,0,0,0.08);
}

/* 目标点 */
.cell.target {
  display: flex;
  align-items: center;
  justify-content: center;
}

.target-diamond {
  width: 36%;
  height: 36%;
  background: rgba(231, 76, 60, 0.35);
  border: 3rpx solid rgba(231, 76, 60, 0.6);
  border-radius: 50%;
  animation: targetPulse 2s ease-in-out infinite;
}

@keyframes targetPulse {
  0%, 100% { transform: scale(0.85); opacity: 0.6; }
  50% { transform: scale(1.1); opacity: 1; }
}

/* === 箱子 === */
.cell.box {
  display: flex;
  align-items: center;
  justify-content: center;
}

.box-body {
  width: 78%;
  height: 78%;
  background: linear-gradient(145deg, #E8C170, #D4A24C);
  border-radius: 8rpx;
  border: 3rpx solid #8B6914;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.35), inset 0 2rpx 0 rgba(255,255,255,0.3);
  overflow: hidden;
}

.box-cross-h, .box-cross-v {
  position: absolute;
  background: rgba(139, 105, 20, 0.25);
}

.box-cross-h {
  width: 100%;
  height: 3rpx;
  top: 50%;
  transform: translateY(-50%);
}

.box-cross-v {
  width: 3rpx;
  height: 100%;
  left: 50%;
  transform: translateX(-50%);
}

/* 箱子到位 - 绿色光效 */
.cell.box-done .box-body {
  background: linear-gradient(145deg, #81C784, #4CAF50);
  border-color: #2E7D32;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.5), 0 0 24rpx rgba(76, 175, 80, 0.3), inset 0 2rpx 0 rgba(255,255,255,0.3);
}

.cell.box-done .box-cross-h,
.cell.box-done .box-cross-v {
  background: rgba(46, 125, 50, 0.3);
}

/* === 玩家 === */
.cell.player {
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.player-body {
  width: 72%;
  height: 72%;
  background: linear-gradient(145deg, #5C9CE6, #3B7DD8);
  border-radius: 50%;
  border: 3rpx solid #2565B8;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(59, 125, 216, 0.4);
  z-index: 2;
}

.player-eye {
  position: absolute;
  width: 20%;
  height: 20%;
  background: white;
  border-radius: 50%;
  top: 28%;
}

.player-eye::after {
  content: '';
  position: absolute;
  width: 55%;
  height: 55%;
  background: #1A1A2E;
  border-radius: 50%;
  top: 20%;
  left: 25%;
}

.left-eye {
  left: 22%;
}

.right-eye {
  right: 22%;
}

.player-mouth {
  position: absolute;
  width: 28%;
  height: 14%;
  border-bottom: 3rpx solid white;
  border-radius: 0 0 50% 50%;
  bottom: 24%;
  left: 36%;
}

/* === 通关弹窗 === */
.win-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.win-card {
  width: 560rpx;
  background: white;
  border-radius: 36rpx;
  padding: 60rpx 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: scaleIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes scaleIn {
  from { transform: scale(0.5); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.win-emoji {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.win-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #2C3E50;
  margin-bottom: 12rpx;
}

.win-steps {
  font-size: 28rpx;
  color: #95A5A6;
  margin-bottom: 40rpx;
}

.win-actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.win-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s;
}

.win-btn:active {
  transform: scale(0.96);
}

.win-btn.secondary {
  background: #F5F5F5;
  color: #666;
}

.win-btn.primary {
  background: linear-gradient(135deg, #D4A574, #B8860B);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(184, 134, 11, 0.3);
}

.win-btn-back {
  margin-top: 24rpx;
  padding: 12rpx;
}

.back-text {
  font-size: 26rpx;
  color: #B0B0B0;
}

/* iPad 适配 */
@media (min-width: 768px) {
  .top-bar {
    padding: 12px 24px;
  }

  .level-label { font-size: 22px; }
  .steps-count { font-size: 20px; }

  .action-btn {
    width: 44px;
    height: 44px;
  }

  .action-icon { font-size: 22px; }

  .win-card {
    width: 380px;
    padding: 40px 36px 30px;
    border-radius: 24px;
  }

  .win-emoji { font-size: 56px; }
  .win-title { font-size: 30px; }
  .win-steps { font-size: 18px; }

  .win-btn {
    height: 56px;
    border-radius: 28px;
    font-size: 18px;
  }
}
